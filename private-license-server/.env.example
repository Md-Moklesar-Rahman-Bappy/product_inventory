# Private License Server - Environment Configuration
# This is a SEPARATE Laravel application from the inventory system.
# Deploy this on a PRIVATE server that is NOT publicly accessible.

APP_NAME="License Server"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://license.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=license_server
DB_USERNAME=root
DB_PASSWORD=

LICENSE_SIGNING_SECRET=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-KEY
LICENSE_DEFAULT_DURATION_DAYS=365
LICENSE_ALLOWED_API_IPS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
